# Copier ce fichier en .env et remplir les valeurs. Ne jamais commiter .env.

# Postgres
POSTGRES_USER=kemet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kemet
# En dev sans Docker uniquement : avec docker-compose, infra/docker-compose.yml
# construit DATABASE_URL à partir des trois variables ci-dessus.
DATABASE_URL=postgres://kemet:kemet@localhost:5432/kemet

# Valkey (cache, pub/sub Socket.IO, files BullMQ)
VALKEY_URL=redis://localhost:6379

# Serveur
API_PORT=3001
REALTIME_PORT=3002
WORKER_PORT=3003

# Fichiers envoyés (images, mèmes), montés sur un volume disque du serveur
UPLOADS_DIR=/data/uploads
# Taille maximale d'un fichier envoyé, et quota de stockage total par utilisateur.
MAX_ATTACHMENT_BYTES=26214400
MAX_USER_STORAGE_BYTES=524288000

# Lien de parrainage Datacloud affiché sur le bouton "Déployer sur Datacloud"
# de chaque page projet. Non défini : le bouton ne s'affiche pas.
DATACLOUD_REFERRAL_URL=

# Anti-spam : un compte créé depuis moins de ANTI_SPAM_NEW_ACCOUNT_WINDOW_HOURS
# heures reçoit une fraction (ANTI_SPAM_NEW_ACCOUNT_FACTOR) de la limite
# normale d'envoi de messages, de posts et de fichiers.
ANTI_SPAM_NEW_ACCOUNT_WINDOW_HOURS=24
ANTI_SPAM_NEW_ACCOUNT_FACTOR=0.25

# Adresse d'écoute de Caddy (infra/Caddyfile). C'est le seul réglage qui
# distingue le local de la production :
#   - en local :80 (HTTP simple, pas de certificat)
#   - en production le domaine réel, ex. kemet.example.com, ou à défaut un
#     sous-domaine sslip.io (ex. 203-0-113-10.sslip.io) : Caddy obtient alors
#     seul un certificat Let's Encrypt, aucune autre variable à régler.
PUBLIC_HOST=:80

# Production uniquement : préfixe des images publiées sur GHCR par le
# workflow Images, que infra/deploy.sh télécharge au lieu de construire.
# Vide en local et en CI (images construites sur place, kemet-<service>:local).
# En production : ghcr.io/cheikhmbackecisse/kemet
KEMET_IMAGE_PREFIX=

# Production uniquement : clé publique age (commence par "age1") pour
# chiffrer les sauvegardes de infra/server/backup.sh. La clé privée
# correspondante ne va jamais sur le serveur.
BACKUP_AGE_RECIPIENT=

# Authentification (Better Auth)
BETTER_AUTH_SECRET=
# Origine de l'API (sert de base aux liens de vérification et de
# réinitialisation envoyés par email).
BETTER_AUTH_URL=http://localhost:3001
# Origine de l'app web (où rediriger une fois l'email vérifié ou le mot de
# passe réinitialisé).
WEB_APP_URL=http://localhost:5173
# Origines supplémentaires acceptées par Better Auth et Socket.IO, séparées
# par des virgules. Utile pour tester depuis un téléphone sur le même réseau :
# ajouter l'adresse IP locale de la machine, ex. http://192.168.1.7:5173.
# Vide par défaut, ignoré en production.
EXTRA_TRUSTED_ORIGINS=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Distinct de GOOGLE_GENERATIVE_AI_API_KEY (IA, section plus bas) : ceci est
# un client OAuth "Connexion Google" classique, créé gratuitement sur Google
# Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Pas de "Se connecter avec Apple" : nécessite un compte Apple Developer
# Program payant (99 USD/an), contrairement à GitHub, Google et LinkedIn.
# Limite de débit de Better Auth sur les routes d'authentification, activée
# par défaut. À mettre à "false" seulement pour la pile e2e de la CI, qui
# crée plusieurs comptes de suite depuis la même adresse IP.
AUTH_RATE_LIMIT_ENABLED=

# Base de test pour les tests d'intégration (packages/db, apps/server).
# Non définie : ces tests sont ignorés avec un message explicite.
DATABASE_URL_TEST=

# IA
# Principal : Google Gemini (famille Flash), via @ai-sdk/google.
GOOGLE_GENERATIVE_AI_API_KEY=
# Secours : OpenRouter, modèles gratuits. Bascule automatique sur une erreur
# de quota (429) ou une indisponibilité du principal.
OPENROUTER_API_KEY=

# Email (relais SMTP Brevo ou Resend). En dev, pointer vers Mailpit
# (infra/docker-compose.yml) : SMTP_HOST=localhost, SMTP_PORT=1025, pas
# d'identifiants, interface sur http://localhost:8025.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=kemet@example.com
