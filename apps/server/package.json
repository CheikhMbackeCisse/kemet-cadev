    "fastify": "^5.2.0",
    "socket.io": "^4.8.0",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vitest": "^2.1.0"
  }
}
