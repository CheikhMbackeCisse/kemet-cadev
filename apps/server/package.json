{
  "name": "@kemet/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch src/api/main.ts\" \"tsx watch src/realtime/main.ts\" \"tsx watch src/worker/main.ts\"",
