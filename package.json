{
  "name": "kemet",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "ignoredOptionalDependencies": [
      "@napi-rs/canvas"
    ]
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "licenses:check": "tsx scripts/check-licenses.ts",
    "test:scripts": "tsx --test scripts/lockfile-platforms.test.ts",
    "eval:llm-throughput": "tsx evals/llm-throughput.ts",
    "eval:work-matching": "tsx evals/work-matching.ts",
    "db:migrate": "pnpm --filter @kemet/db migrate",
    "db:seed": "pnpm --filter @kemet/db seed",
    "db:seed:demo": "pnpm --filter @kemet/db seed",
    "db:promote-admin": "pnpm --filter @kemet/db promote-admin"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/d3-geo": "^3.1.1",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "3.1.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "topojson-client": "3.1.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "world-atlas": "2.0.2"
  }
}
