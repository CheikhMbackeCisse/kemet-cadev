# PUBLIC_HOST pilote à la fois l'adresse d'écoute et le HTTPS automatique :
#   - ":80" en local : Caddy écoute en HTTP simple, pas de certificat.
#   - un domaine réel ou un nom sslip.io en production : Caddy obtient seul
#     un certificat Let's Encrypt, sans autre réglage.
{$PUBLIC_HOST} {
	# Les fichiers de l'app arrivent déjà compressés en Brotli par le serveur
	# web ; encode ne retouche pas une réponse qui porte Content-Encoding.
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Socket.IO garde son chemin tel quel : pas de handle_path, qui le
	# tronquerait avant qu'il n'atteigne le serveur realtime.
	handle /socket.io/* {
		reverse_proxy realtime:3002
	}

	# /realtime/health existe uniquement pour que la page d'accueil puisse
	# vérifier l'état du service realtime depuis le navigateur. Le serveur
	# realtime répond sur /health : handle_path /realtime/health retirait le
	# chemin entier et renvoyait vers /, d'où une 404.
	handle /realtime/health {
		rewrite * /health
		reverse_proxy realtime:3002
	}

	# Pas de handle_path : l'API déclare ses routes avec le préfixe /api.
	handle /api/* {
		reverse_proxy api:3001
	}

	# style-src garde 'unsafe-inline' : MobileTabBar.tsx et les composants
	# Radix positionnés par Popper posent des attributs style à l'exécution.
	# font-src accepte data: : Vite insère en base64 les plus petits fichiers
	# de police de @fontsource, bloqués sinon.
	# img-src blob: : aperçu local d'une image choisie, avant son envoi.
	# media-src : vidéos des travaux, servies par l'API sur la même origine.
	# frame-src : seul le lecteur YouTube sans cookie, chargé au clic.
	# L'API pose sa propre politique, plus stricte.
	handle {
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self'; frame-src https://www.youtube-nocookie.com; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		reverse_proxy web:8080
	}
}

# Redirige www vers l'adresse principale, avec son propre certificat.
# WWW_HOST vaut www.kemetlabs.dev en production. Sa valeur par défaut
# (infra/docker-compose.yml) est un nom local en HTTP simple, jamais
# appelé, pour garder un Caddyfile valide en local et en CI.
{$WWW_HOST} {
	redir https://{$PUBLIC_HOST}{uri} permanent
}
