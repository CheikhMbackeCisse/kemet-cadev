# PUBLIC_HOST pilote à la fois l'adresse d'écoute et le HTTPS automatique :
#   - ":80" en local : Caddy écoute en HTTP simple, pas de certificat.
#   - un domaine réel ou un nom sslip.io en production : Caddy obtient seul
#     un certificat Let's Encrypt, sans autre réglage.
{$PUBLIC_HOST} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Socket.IO garde son chemin tel quel : pas de handle_path, qui le
	# tronquerait avant qu'il n'atteigne le serveur realtime.
	handle /socket.io/* {
		reverse_proxy realtime:3002
	}

	# /realtime/health existe uniquement pour que la page d'accueil puisse
	# vérifier l'état du service realtime depuis le navigateur.
	handle_path /realtime/health {
		reverse_proxy realtime:3002
	}

	# Pas de handle_path : l'API enregistre toutes ses routes avec le préfixe
	# /api inclus (/api/me, /api/auth/*, /api/spaces/*, et /api/health en
	# plus de /health, ce dernier réservé au healthcheck Docker qui
	# interroge le conteneur directement sans passer par Caddy).
	handle /api/* {
		reverse_proxy api:3001
	}

	# apps/web est une app React servie sans script en ligne. style-src garde
	# 'unsafe-inline' : un style dynamique dans le code
	# (apps/web/src/components/shell/MobileTabBar.tsx) et les composants
	# Radix basés sur Popper (Select, Menu, Tooltip) posent tous deux des
	# attributs style en ligne au runtime pour le positionnement. Un
	# refactor qui viserait à retirer 'unsafe-inline' devrait traiter les
	# deux sources, pas seulement MobileTabBar.tsx, et reste hors de ce
	# correctif. L'API (handle /api/*) pose sa propre politique, plus
	# stricte, elle-même (apps/server/src/api/app.ts) : cette en-tête ne
	# vaut que pour l'app web, jamais pour /api/* ni /socket.io/*.
	handle {
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		reverse_proxy web:8080
	}
}
